{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "MSVC: 编译当前文件",
            "command": "cl.exe",
            "args": [
                "/nologo",
                "/Zi",
                "/EHsc",
                "/std:c++20",
                "/Fd${workspaceFolder}\\build\\${fileDirnameBasename}_${fileBasenameNoExtension}.pdb",
                "/Fo${workspaceFolder}\\build\\${fileDirnameBasename}_${fileBasenameNoExtension}.obj",
                "/Fe${workspaceFolder}\\build\\${fileDirnameBasename}_${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译当前文件(exe/obj/pdb 全部输出到 build):Ctrl+Shift+B 编译、F5 调试、▶ 运行,三个入口共用这一个任务"
        }
    ]
}